# Copy this file to .env and fill in your values. Never commit .env anywhere.

# --- Reddit API (script app, read-only) ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=macos:state-civic-listener:v1.0 (by /u/YOUR_REDDIT_USERNAME)

# --- OpenRouter ---
OPENROUTER_API_KEY=
# Free models change weekly. Run scripts/pick_model.py (or see README) to re-check.
CLASSIFIER_MODEL=openai/gpt-oss-120b:free
CLASSIFIER_FALLBACK_MODEL=z-ai/glm-4.5-air:free

# --- Apify (Facebook public groups, free tier) ---
APIFY_TOKEN=

# --- Paths (defaults are fine) ---
STATE_INTEL_DB=data/state_intel.db

# --- Netlify auto-deploy (optional) ---
# If both are set AND the netlify CLI is installed, each pipeline run publishes
# the rebuilt site/ to production automatically. Leave blank to build locally
# only. Get the token at Netlify > User settings > Applications > New access
# token; get the site ID at Site settings > General > Site ID.
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
